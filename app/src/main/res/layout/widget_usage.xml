<?xml version="1.0" encoding="utf-8"?>
<!--
    ویجت «مصرف امروز» — چیدمان ساختارمند و قابل تغییر اندازه.

    سربرگ: نشان برنامه، عنوان، اپراتور، نشان وضعیت پایش و دکمه‌ی تازه‌سازی
    بدنه:  عدد بزرگ مصرف امروز + نشان درصد بسته
    کارت‌ها: موبایل و وای‌فای، هر کدام با نقطه‌ی رنگی خودشان
    بسته:  باقی‌مانده، نوار پیشرفت رنگی و «مصرف از کل»
    کامل:  ردیف دانلود/آپلود و دو میان‌بر (توقف/ادامه‌ی پایش و گزارش‌ها)

    کدام بخش‌ها دیده شوند را WidgetLayout بر اساس ارتفاع/عرض واقعی ویجت
    تصمیم می‌گیرد؛ رنگ‌ها هم در WidgetTheme محاسبه می‌شوند. پس‌زمینه یا سطح تم
    است یا گرادیان اپراتور (همان پالت کارت صفحه‌ی خانه و اعلان).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="4dp">

    <!--
        قاب کارت: لایه‌های گرادیان اپراتور زیر محتوا می‌نشینند. وقتی ویجت «هم‌رنگ
        اپراتور» است، WidgetRenderer این لایه‌ها را رنگ می‌کند و نشان می‌دهد؛ در غیر
        این صورت پنهان می‌مانند و سطح تم (تاریک/روشن/AMOLED) پشت محتوا دیده می‌شود.
        رنگ‌ها با setColorFilter/setImageAlpha تزریق می‌شوند که روی همه‌ی نسخه‌ها کار می‌کند.
    -->
    <FrameLayout
        android:id="@+id/widget_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_brand_base"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_brand_fill"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/widget_brand_start"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_brand_fade_tl"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/widget_brand_end"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_brand_fade_br"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/widget_brand_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_brand_glow_tr"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/widget_brand_rim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_brand_rim"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_surface_dark"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <!-- سربرگ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_badge"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/widget_badge"
                android:contentDescription="@null"
                android:padding="5dp"
                android:src="@drawable/ic_notification" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_today"
                    android:textColor="#EAF0FF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/widget_operator"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:textStyle="normal"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#A6B2CF"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip"
                android:ellipsize="end"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:textColor="#EAF0FF"
                android:textSize="9sp" />

            <ImageView
                android:id="@+id/widget_refresh"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:contentDescription="@string/widget_refresh_desc"
                android:focusable="false"
                android:src="@drawable/ic_widget_refresh" />
        </LinearLayout>

        <!-- عدد بزرگ مصرف امروز -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="—"
                android:textColor="#FFFFFFFF"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/widget_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_marginBottom="3dp"
                android:ellipsize="end"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#A6B2CF"
                android:textSize="12sp" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/widget_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:background="@drawable/widget_chip"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:textColor="#EAF0FF"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:textStyle="normal"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#8E9BBA"
            android:textSize="10sp"
            android:visibility="gone" />

        <!-- کارت‌های موبایل / وای‌فای -->
        <LinearLayout
            android:id="@+id/widget_split_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/widget_mobile_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/widget_card"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_mobile_dot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/widget_dot"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/widget_mobile_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:textStyle="normal"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_mobile"
                        android:textColor="#A6B2CF"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_mobile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="—"
                    android:textColor="#5CE9CF"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_wifi_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/widget_card"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_wifi_dot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/widget_dot"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/widget_wifi_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:textStyle="normal"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/wifi"
                        android:textColor="#A6B2CF"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_wifi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="—"
                    android:textColor="#7FB8FF"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- نوار سقف بسته -->
        <LinearLayout
            android:id="@+id/widget_cap_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_cap_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:textStyle="normal"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/widget_remaining"
                    android:textColor="#A6B2CF"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/widget_cap_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#5CE9CF"
                    android:textSize="11sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/widget_cap_progress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="5dp"
                android:max="100"
                android:progressDrawable="@drawable/widget_progress" />

            <TextView
                android:id="@+id/widget_cap_used"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:textStyle="normal"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#8E9BBA"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- ردیف دانلود/آپلود (حالت کامل) -->
        <LinearLayout
            android:id="@+id/widget_detail_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/widget_rx"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:textStyle="normal"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#8E9BBA"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/widget_tx"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:textStyle="normal"
                android:gravity="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#8E9BBA"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- میان‌برها -->
        <LinearLayout
            android:id="@+id/widget_actions_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/widget_action_toggle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/widget_action"
                android:clickable="true"
                android:focusable="false"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:id="@+id/widget_action_toggle_icon"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_widget_pause" />

                <TextView
                    android:id="@+id/widget_action_toggle_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:ellipsize="end"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#EAF1FF"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_action_reports"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/widget_action"
                android:clickable="true"
                android:focusable="false"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:id="@+id/widget_action_reports_icon"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_widget_reports" />

                <TextView
                    android:id="@+id/widget_action_reports_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:ellipsize="end"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="#EAF1FF"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    </FrameLayout>
</LinearLayout>
