<?xml version="1.0" encoding="utf-8"?>
<!--
    اعلان پایش، حالت باز: کارت گرادیانی اپراتور با لوگو، عنوان، خلاصه یا خطوط تفصیلی و
    نوار پیشرفت (سقف بسته یا سهم موبایل). نوار پیشرفت دو نسخه دارد: روشن برای گرادیان‌های
    تیره و تیره برای گرادیان‌های روشن (مثل زرد ایرانسل)؛ فقط یکی نمایش داده می‌شود.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/notif_brand_base"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/notif_brand_fill" />

    <ImageView
        android:id="@+id/notif_brand_start"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/notif_brand_fade_tl" />

    <ImageView
        android:id="@+id/notif_brand_end"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/notif_brand_fade_br" />

    <ImageView
        android:id="@+id/notif_brand_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/notif_brand_glow_tr" />

    <ImageView
        android:id="@+id/notif_brand_rim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/notif_brand_rim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="11dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/notif_logo_tile"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/notif_logo_tile"
                android:padding="1.5dp">

                <ImageView
                    android:id="@+id/notif_logo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_notification" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/notif_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/notif_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:textAlignment="viewStart"
                    android:textColor="#DDFFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/notif_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.18"
            android:maxLines="6"
            android:textAlignment="viewStart"
            android:textColor="#F0FFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/notif_progress_on_dark"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progressDrawable="@drawable/notif_progress_light"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/notif_progress_on_light"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progressDrawable="@drawable/notif_progress_dark"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
